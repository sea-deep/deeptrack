{
  "projectName": "Four-Wheel Autonomous Mine Rescue Rover",
  "platform": "Cirkit Designer",
  "targetMCU": "ESP32 DevKit V1",
  "powerSystem": {
    "source": "10,000 mAh USB Power Bank (5V / 3A Regulated Dual Output)",
    "topology": {
      "5V_rail": ["ESP32 VIN (5V)", "SG90 Servo V+", "MQ Gas Sensor VCC", "HC-SR04 VCC", "Motor Driver VM/VCC", "5V Power LED (via 220R)"],
      "3.3V_rail": ["ESP32 3V3 LDO", "DHT22 VCC", "MPU6050 VCC", "KY-040 Left Encoder VCC", "KY-040 Right Encoder VCC"],
      "common_ground": "Shared ground bus connecting all components, power bank, and ESP32 GND"
    }
  },
  "components": [
    { "id": "MCU", "type": "ESP32 DevKit V1", "package": "30-pin/38-pin DIP" },
    { "id": "PWR_BANK", "type": "10,000 mAh USB Power Bank", "specs": "5V 3A Dual Output" },
    { "id": "PWR_LED", "type": "5mm Green LED", "currentLimit": "220 ohm" },
    { "id": "DHT22", "type": "DHT22 / AM2302", "interface": "Single-Bus Digital", "pullup": "10k ohm to 3.3V" },
    { "id": "MQ_GAS", "type": "MQ-2 / MQ-4 Gas Sensor", "interface": "Analog", "divider": "10k ohm (upper) / 15k ohm (lower)" },
    { "id": "HC_SR04", "type": "HC-SR04 Ultrasonic", "interface": "Digital Trig/Echo", "echoDivider": "10k ohm (upper) / 15k ohm (lower)" },
    { "id": "MPU6050", "type": "MPU-6050 6-DoF IMU", "interface": "I2C (0x68)" },
    { "id": "ENC_L", "type": "KY-040 Rotary Encoder (Left Wheel)", "interface": "Digital Interrupt" },
    { "id": "ENC_R", "type": "KY-040 Rotary Encoder (Right Wheel)", "interface": "Digital Interrupt", "pullup": "10k ohm" },
    { "id": "SERVO", "type": "SG90 Micro Servo (Mine Scanner)", "interface": "50Hz PWM" },
    { "id": "BUZZER", "type": "Piezo Warning Buzzer", "interface": "Digital / PWM", "resistor": "220 ohm" },
    { "id": "MOTOR_DRIVER", "type": "L298N / TB6612 Dual H-Bridge Driver", "motors": 4 }
  ],
  "netlist": [
    { "net": "5V_HIGH_CURRENT", "nodes": ["PWR_BANK:VBUS", "ESP32:5V_VIN", "HC_SR04:VCC", "MQ_GAS:VCC", "SERVO:V+", "MOTOR_DRIVER:VM", "PWR_LED:ANODE_VIA_220R"] },
    { "net": "3V3_LOGIC", "nodes": ["ESP32:3V3", "DHT22:VCC", "MPU6050:VCC", "ENC_L:VCC", "ENC_R:VCC", "DHT22:PULLUP", "ENC_R:PULLUP"] },
    { "net": "GND_COMMON", "nodes": ["PWR_BANK:GND", "ESP32:GND", "DHT22:GND", "MQ_GAS:GND", "HC_SR04:GND", "MPU6050:GND", "ENC_L:GND", "ENC_R:GND", "SERVO:GND", "BUZZER:NEG", "MOTOR_DRIVER:GND", "PWR_LED:CATHODE", "DIVIDERS:GND"] },
    { "net": "DHT22_DATA", "nodes": ["DHT22:DATA", "ESP32:GPIO23"] },
    { "net": "MQ_GAS_ANALOG", "nodes": ["MQ_GAS:AO", "DIVIDER_GAS:IN", "ESP32:GPIO34"] },
    { "net": "SONAR_TRIG", "nodes": ["HC_SR04:TRIG", "ESP32:GPIO19"] },
    { "net": "SONAR_ECHO", "nodes": ["HC_SR04:ECHO", "DIVIDER_SONAR:IN", "ESP32:GPIO18"] },
    { "net": "I2C_SDA", "nodes": ["MPU6050:SDA", "ESP32:GPIO21"] },
    { "net": "I2C_SCL", "nodes": ["MPU6050:SCL", "ESP32:GPIO22"] },
    { "net": "ENC_LEFT_CLK", "nodes": ["ENC_L:CLK", "ESP32:GPIO32"] },
    { "net": "ENC_RIGHT_CLK", "nodes": ["ENC_R:CLK", "ESP32:GPIO35"] },
    { "net": "SERVO_PWM", "nodes": ["SERVO:PWM", "ESP32:GPIO13"] },
    { "net": "BUZZER_SIGNAL", "nodes": ["BUZZER:POS_VIA_220R", "ESP32:GPIO4"] },
    { "net": "MOTOR_LEFT_PWM", "nodes": ["MOTOR_DRIVER:IN1_IN2_ENA", "ESP32:GPIO25"] },
    { "net": "MOTOR_RIGHT_PWM", "nodes": ["MOTOR_DRIVER:IN3_IN4_ENB", "ESP32:GPIO14"] }
  ]
}
