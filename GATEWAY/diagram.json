  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["lcd:GND", "esp:GND.1", "black", ["h-20", "v40"]],
    ["lcd:VCC", "esp:5V", "red", ["h-30", "v50"]],
    ["lcd:SDA", "esp:21", "green", ["h-40", "v60"]],
    ["lcd:SCL", "esp:22", "blue", ["h-50", "v70"]],

    ["esp:26", "r_red:1", "red", ["h20"]],
    ["r_red:2", "led_red:A", "red", ["h10"]],
    ["led_red:C", "esp:GND.2", "black", ["v60", "h-200"]],

    ["esp:27", "r_green:1", "green", ["h20"]],
    ["r_green:2", "led_green:A", "green", ["h10"]],
    ["led_green:C", "esp:GND.2", "black", ["v40", "h-200"]],

    ["esp:25", "r_yellow:1", "orange", ["h20"]],
    ["r_yellow:2", "led_yellow:A", "orange", ["h10"]],
    ["led_yellow:C", "esp:GND.2", "black", ["v20", "h-200"]]
  ]
