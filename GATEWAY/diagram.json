    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": -220,
      "left": -100,
      "attrs": { "pins": "i2c" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": -60,
      "left": 320,
      "attrs": { "color": "red", "label": "DANGER" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": -20,
      "left": 280,
      "attrs": { "resistance": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 20,
      "left": 320,
      "attrs": { "color": "green", "label": "NORMAL" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": 60,
      "left": 280,
      "attrs": { "resistance": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_yellow",
      "top": 100,
      "left": 320,
      "attrs": { "color": "yellow", "label": "HEARTBEAT" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_yellow",
      "top": 140,
      "left": 280,
      "attrs": { "resistance": "220" }
    },
    {
      "type": "wokwi-text",
      "id": "label_title",
      "top": -280,
      "left": -100,
      "attrs": { "text": "DEEPTRACK Gateway" }
    },
    {
      "type": "wokwi-text",
      "id": "label_lcd",
      "top": -140,
      "left": -100,
      "attrs": { "text": "16x2 I2C LCD (0x27)" }
    },
    {
      "type": "wokwi-text",
      "id": "label_leds",
      "top": -100,
      "left": 280,
      "attrs": { "text": "Status LEDs" }
    }
