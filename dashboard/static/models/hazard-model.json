      { "feature": "gasRate", "threshold": 75, "size": 64, "left": { "feature": "climateCoupling", "threshold": 0.22, "size": 58, "left": { "leaf": true, "size": 51 }, "right": { "leaf": true, "size": 3 } }, "right": { "leaf": true, "size": 1 } },
      { "feature": "temperatureRate", "threshold": 0.65, "size": 64, "left": { "feature": "humidityRate", "threshold": 1.2, "size": 57, "left": { "leaf": true, "size": 50 }, "right": { "leaf": true, "size": 2 } }, "right": { "leaf": true, "size": 1 } },
      { "feature": "tiltMagnitude", "threshold": 12, "size": 64, "left": { "feature": "encoderMismatch", "threshold": 0.28, "size": 55, "left": { "leaf": true, "size": 48 }, "right": { "leaf": true, "size": 2 } }, "right": { "leaf": true, "size": 1 } },
      { "feature": "tiltEncoderCoupling", "threshold": 2.5, "size": 64, "left": { "leaf": true, "size": 52 }, "right": { "leaf": true, "size": 1 } },
      { "feature": "waterRaw", "threshold": 720, "size": 64, "left": { "feature": "frontClearanceCm", "threshold": 52, "size": 58, "left": { "leaf": true, "size": 2 }, "right": { "leaf": true, "size": 49 } }, "right": { "leaf": true, "size": 1 } },
      { "feature": "waterRate", "threshold": 130, "size": 64, "left": { "leaf": true, "size": 53 }, "right": { "leaf": true, "size": 1 } },
      { "feature": "frontClearanceCm", "threshold": 42, "size": 64, "left": { "leaf": true, "size": 1 }, "right": { "feature": "gasRaw", "threshold": 1080, "size": 55, "left": { "leaf": true, "size": 48 }, "right": { "leaf": true, "size": 2 } } },
      { "feature": "packetGapRate", "threshold": 2, "size": 64, "left": { "feature": "heartbeatAgeMs", "threshold": 430, "size": 58, "left": { "leaf": true, "size": 51 }, "right": { "leaf": true, "size": 2 } }, "right": { "leaf": true, "size": 1 } },
      { "feature": "rssiWeakness", "threshold": 22, "size": 64, "left": { "leaf": true, "size": 52 }, "right": { "leaf": true, "size": 1 } },
      { "feature": "humidity", "threshold": 82, "size": 64, "left": { "feature": "temperature", "threshold": 35, "size": 57, "left": { "leaf": true, "size": 50 }, "right": { "leaf": true, "size": 2 } }, "right": { "leaf": true, "size": 2 } },
      { "feature": "encoderMismatch", "threshold": 0.38, "size": 64, "left": { "feature": "tiltMagnitude", "threshold": 9, "size": 56, "left": { "leaf": true, "size": 49 }, "right": { "leaf": true, "size": 3 } }, "right": { "leaf": true, "size": 1 } }
    ]
  }
}
