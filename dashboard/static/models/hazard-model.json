{
  "schemaVersion": 1,
  "version": "sentinel-iforest-demo-1.0.0",
  "trainingDate": "2026-08-27",
  "trainingScope": "Synthetic and bench-shaped normal-operation baseline; advisory demonstration model, not safety-certified",
  "baselineSeconds": 60,
  "scoreCalibration": { "offset": 0.52, "range": 0.30 },
  "features": {
