    "gasRate": { "label": "MQ-4 rate", "category": "gas", "center": 0, "scale": 30, "direction": "both", "weight": 1.15 },
    "temperature": { "label": "Temperature", "category": "climate", "center": 29, "scale": 2.5, "direction": "both", "weight": 0.8 },
    "temperatureRate": { "label": "Temperature rate", "category": "climate", "center": 0, "scale": 0.22, "direction": "high", "weight": 1.0 },
    "humidity": { "label": "Humidity", "category": "humidity", "center": 69, "scale": 5, "direction": "both", "weight": 0.7 },
    "humidityRate": { "label": "Humidity rate", "category": "humidity", "center": 0, "scale": 0.55, "direction": "high", "weight": 0.8 },
    "climateCoupling": { "label": "Coupled climate rise", "category": "climate", "center": 0, "scale": 0.12, "direction": "high", "weight": 1.0 },
    "tiltMagnitude": { "label": "Chassis tilt", "category": "stability", "center": 3.5, "scale": 4, "direction": "high", "weight": 1.1 },
    "waterRaw": { "label": "Water-contact raw signal", "category": "water", "center": 350, "scale": 130, "direction": "both", "weight": 0.9 },
    "waterRate": { "label": "Water-contact rate", "category": "water", "center": 0, "scale": 45, "direction": "both", "weight": 0.8 },
    "frontClearanceCm": { "label": "Front clearance", "category": "clearance", "center": 120, "scale": 24, "direction": "low", "weight": 1.0 },
    "encoderMismatch": { "label": "Encoder disagreement", "category": "mobility", "center": 0.02, "scale": 0.09, "direction": "high", "weight": 1.15 },
    "tiltEncoderCoupling": { "label": "Tilt + encoder coupling", "category": "stability", "center": 0.1, "scale": 0.7, "direction": "high", "weight": 1.1 },
    "packetGapRate": { "label": "Packet-gap rate", "category": "link", "center": 0, "scale": 0.5, "direction": "high", "weight": 0.9 },
    "heartbeatAgeMs": { "label": "Telemetry delay", "category": "link", "center": 55, "scale": 160, "direction": "high", "weight": 1.0 },
    "rssiWeakness": { "label": "Radio weakness", "category": "link", "center": 0, "scale": 10, "direction": "high", "weight": 0.7 }
